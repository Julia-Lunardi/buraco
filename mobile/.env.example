# Local development (Expo Go / dev build). .env is gitignored, so EAS builds take these
# from eas.json instead (Salvie: missing client ids crashed TestFlight on launch).
# Your Mac's LAN IP, not localhost: the phone cannot reach the Mac's localhost.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8001
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Simulated tip purchases (also on automatically in Expo Go).
EXPO_PUBLIC_TIP_JAR_MOCK=0
