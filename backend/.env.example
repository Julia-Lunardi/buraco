# Copy to .env for local development.
DATABASE_URL=postgresql+asyncpg://buraco:buraco@localhost:5434/buraco
SECRET_KEY=any-random-string-for-local
ENVIRONMENT=local
# In Azure: true, plus AZURE_CLIENT_ID of the container app's identity. The
# DATABASE_URL then has no password (Entra token auth on psql-woddie-de).
DB_USE_MANAGED_IDENTITY=false

# Sign-in. GOOGLE_CLIENT_ID is the WEB client (also the audience of Android tokens).
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=com.buraco.app
