.envrc

# ── Terraform ──────────────────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
# Only the root terraform.tfvars is secret-bearing. The per-environment files in
# infra/variables/ hold resource names and object IDs, not credentials, and the
# deploy workflow reads them from the checkout — ignoring them made every
# `terraform init` in CI fail with "Failed to read file".
terraform.tfvars
# Allow the example file so developers know what variables are needed
!*.tfvars.example
*.tfplan

# ── Editors ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
# Keep launch.json so debugger configs are shared
!.vscode/launch.json

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

